# ---------------------------------------------------------------------------
# Frontend (Vite) — points at YOUR self-hosted Supabase, never at Lovable.
# Copy to frontend/.env
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=<your-self-hosted-anon-key>
VITE_SUPABASE_PROJECT_ID=selfhosted

# ---------------------------------------------------------------------------
# Edge functions (Deno) — put these in supabase/functions/.env or the
# environment of your edge-runtime container.
# ---------------------------------------------------------------------------

# Your own stack
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=<your-self-hosted-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-self-hosted-service-role-key>
SUPABASE_JWKS=<jwks-json-of-your-auth-signing-keys>

# THE ONLY LINK TO LOVABLE — the stateless ai-generate transport.
AI_GENERATE_URL=https://<lovable-project-ref>.supabase.co/functions/v1/ai-generate
BOT_API_KEY=<the-key-issued-to-this-bot>

# WhatsApp
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=<waha-api-key>
WSENDER_API_KEY=<wsender-api-key>

# MinIO media storage
MINIO_ENDPOINT=https://storage.buildstart.io
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_REGION=us-east-1

# Push notifications (optional)
FIREBASE_SERVICE_ACCOUNT_JSON=<single-line-service-account-json>
